#!/bin/bash
set -euo pipefail

arch_packages=(
{{- range .apps.arch }}
  {{ printf "%q" . }}
{{- end }}
)

aur_packages=(
{{- range .apps.aur }}
  {{ printf "%q" . }}
{{- end }}
)

removed_packages=(
{{- range .apps.remove }}
  {{ printf "%q" . }}
{{- end }}
)

if (( ${#arch_packages[@]} )); then
  sudo pacman -S --needed --noconfirm "${arch_packages[@]}"
fi

if (( ${#aur_packages[@]} )); then
  aur_helper="$(command -v paru || command -v yay || true)"
  if [[ -z $aur_helper ]]; then
    echo "An AUR helper (paru or yay) is required for AUR packages." >&2
    exit 1
  fi
  "$aur_helper" -S --needed --noconfirm "${aur_packages[@]}"
fi

installed_removed=()
for package in "${removed_packages[@]}"; do
  if pacman -Q "$package" >/dev/null 2>&1; then
    installed_removed+=("$package")
  fi
done

if (( ${#installed_removed[@]} )); then
  sudo pacman -Rns --noconfirm "${installed_removed[@]}"
fi

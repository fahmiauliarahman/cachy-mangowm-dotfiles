font=JetBrainsMono Nerd Font 11
background-color=#222730ee
text-color=#d8dee9
border-color=#81a1c1
border-size=2
border-radius=2
padding=10
margin=8
width=320
height=120
anchor=top-right
default-timeout=5000
ignore-timeout=0
layer=overlay
max-visible=5
icons=1
max-icon-size=32
markup=1
format=<b>%s</b>\n%b
group-by=app-name

[urgency=low]
border-color=#4c566a
default-timeout=3000

[urgency=high]
border-color=#bf616a
text-color=#d8dee9
default-timeout=0

[mode=do-not-disturb]
invisible=1

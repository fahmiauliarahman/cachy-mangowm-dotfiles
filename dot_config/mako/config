font=JetBrainsMono Nerd Font 11
background-color=#101520ee
text-color=#d1dae8
border-color=#6c7e97
border-size=2
border-radius=8
padding=10
margin=8
width=320
height=120
anchor=top-right
default-timeout=5000
ignore-timeout=0
layer=overlay
max-visible=5
icons=1
max-icon-size=32
markup=1
format=<b>%s</b>\n%b
group-by=app-name

[urgency=low]
border-color=#2a3648
default-timeout=3000

[urgency=high]
border-color=#ad401f
text-color=#e0e8f0
default-timeout=0

[mode=do-not-disturb]
invisible=1
